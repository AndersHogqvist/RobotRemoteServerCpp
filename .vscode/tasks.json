{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake-configure-http-server",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build/http-server",
        "-DROBOT_REMOTE_ENABLE_HTTP_SERVER=TRUE"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "cmake-build-http-server",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build/http-server"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-http-server",
      "dependsOn": [
        "cmake-configure-http-server",
        "cmake-build-http-server"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
