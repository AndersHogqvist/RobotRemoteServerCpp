{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default-release",
      "displayName": "Default release (include HTTP Server, static library)",
      "description": "Default configure preset",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROBOT_REMOTE_ENABLE_HTTP_SERVER": "TRUE"
      }
    },
    {
      "name": "release-no-http",
      "displayName": "Release without HTTP Server (static library)",
      "description": "Configure without integrated HTTP keyword documentation server",
      "binaryDir": "${sourceDir}/build/release-no-http",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROBOT_REMOTE_ENABLE_HTTP_SERVER": "FALSE"
      }
    },
    {
      "name": "release-http-shared",
      "displayName": "Release with HTTP Server (shared library)",
      "description": "Configure with integrated HTTP keyword documentation server",
      "binaryDir": "${sourceDir}/build/release-http-shared",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROBOT_REMOTE_ENABLE_HTTP_SERVER": "TRUE",
        "BUILD_SHARED_LIBS": "TRUE"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Configure debug build",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROBOT_REMOTE_ENABLE_HTTP_SERVER": "TRUE"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default-release"
    },
    {
      "name": "release-no-http",
      "configurePreset": "release-no-http"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    }
  ]
}
